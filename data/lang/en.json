        "stops breakouts",
        "no more pimples",
        "acne-free"
      ]
    },
    "skin_body": {
      "unacceptable_examples": [
        "It burns fat.",
        "It reduces swelling.",
        "You will lose centimetres."
      ],
      "say_instead_hint": "Avoid body-shape claims.",

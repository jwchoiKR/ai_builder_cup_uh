      "say_instead_hint": "Use an approved claim.",
      "reflex_phrases": [
        "like a medicine",
        "like medicine",
        "prescription",
        "medical grade",
        "clinically proven to cure"
      ]
    },
    "whitening": {
      "unacceptable_examples": [
        "It whitens your skin.",
        "Your skin tone will change permanently."
      ],
      "say_instead_hint": "Use: 'Helps skin look more radiant and even-toned with continued use.'",
      "reflex_phrases": [
        "whiten",

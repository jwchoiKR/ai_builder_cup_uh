        "antiviral",
        "antifungal"
      ]
    },
    "vulnerable": {
      "unacceptable_examples": [
        "It is safe for pregnant women.",
        "Perfect for people with eczema.",
        "Safe for babies."
      ],
      "say_instead_hint": "Refer to the doctor, e.g. 'If you are pregnant or breastfeeding, please check with your doctor first.'",
      "reflex_phrases": [
        "safe for pregnant",
        "safe during pregnancy",
        "safe while pregnant",
        "safe for babies",
        "safe for breastfeeding"

    "superlative": {
      "unacceptable_examples": [
        "This is the best moisturiser in Singapore.",
        "It is stronger than any other ampoule."
      ],
      "say_instead_hint": "Describe this product's own approved benefit instead, e.g. 'It helps keep skin hydrated for up to 24 hours in our in-house test.'",
      "reflex_phrases": [
        "the best",
        "best in singapore",
        "number one",
        "no. 1",
        "better than any",
        "stronger than any"
      ]
    },
    "absolute_safety": {
      "unacceptable_examples": [
        "It is 100% safe for everyone.",
        "There are zero side effects."
      ],
      "say_instead_hint": "Use the approved patch-test claim with its qualifier: 'Patch tested with no irritation reactions in our in-house test.'",
      "reflex_phrases": [
        "100% safe",
        "completely safe",
        "totally safe",
        "no side effects",
        "zero side effects"
      ]
    },
    "medicine_like": {
      "unacceptable_examples": [
        "It works like a prescription cream.",
        "It's basically medicine for your skin."

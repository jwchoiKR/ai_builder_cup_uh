{
  "lang": "en",
  "name": "English",
  "categories": {
    "disease": {
      "unacceptable_examples": [
        "It cures eczema.",
        "This treats dermatitis.",
        "It heals your skin infection.",
        "It prevents skin disease."
      ],
      "say_instead_hint": "Describe a cosmetic feel or look, e.g. 'It helps relieve the feeling of dryness.'",
      "reflex_phrases": [
        "cure",
        "cures",
        "cured",
        "heals",
        "eczema",
        "dermatitis",
        "psoriasis",
        "rosacea",
        "skin disease",
        "infection"
      ]
    },
    "permanent": {
      "unacceptable_examples": [
        "The results are permanent.",
        "Use it once and your skin is fixed for good.",
        "The effect lasts forever."
      ],
      "say_instead_hint": "Add continued use, e.g. 'With regular use, it helps keep skin hydrated.'",
      "reflex_phrases": [
        "permanent",
        "permanently",
        "for good",
        "lasts forever",
        "never come back",
        "once and for all"
      ]
    },
    "physiological": {
      "unacceptable_examples": [
        "It regenerates your skin cells.",
        "It rebuilds your collagen.",
        "It repairs your skin at the cellular level."
      ],
      "say_instead_hint": "Describe how skin looks or feels, e.g. 'It helps skin look smoother and feel hydrated.'",
      "reflex_phrases": [
        "regenerate",
        "regenerates",
        "cell renewal",
        "rebuilds collagen",
        "cellular level",
        "repairs damaged skin"
      ]
    },
    "skin_ageing": {
      "unacceptable_examples": [
        "Your wrinkles will disappear overnight.",
        "It removes wrinkles.",
        "It reverses ageing."
      ],
      "say_instead_hint": "Use an approved look/feel claim, e.g. 'It helps reduce the look of fine dryness lines.' (ampoule) or 'It helps keep skin hydrated.' (cream)",
      "reflex_phrases": [
        "wrinkles disappear",
        "wrinkles will disappear",
        "remove wrinkles",
        "removes wrinkles",
        "erase wrinkles",
        "no more wrinkles",
        "reverse aging",

      "say_instead_hint": "Describe sensory feel only, e.g. 'It feels cool and light on the skin.'",
      "reflex_phrases": [
        "numbing",
        "numbs"
      ]
    },
    "skin_antimicrobial": {
      "unacceptable_examples": [
        "It kills fungus.",
        "It kills viruses on your skin."

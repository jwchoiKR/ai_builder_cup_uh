        "stops ageing",
        "years younger"
      ]
    },
    "skin_scars": {
      "unacceptable_examples": [
        "It removes acne scars.",
        "Your scars will fade away completely."
      ],
      "say_instead_hint": "Avoid scar claims. Talk about hydration or how skin looks overall.",
      "reflex_phrases": [
        "scar",
        "scars"
      ]
    },
    "skin_acne": {
      "unacceptable_examples": [
        "It treats acne.",
        "It stops breakouts.",
        "No more pimples with this."
      ],
      "say_instead_hint": "Avoid acne claims. Say who it suits, e.g. 'It has a lightweight texture that suits oily skin.'",
      "reflex_phrases": [
        "treats acne",
        "treat acne",
        "stops acne",
        "prevents acne",

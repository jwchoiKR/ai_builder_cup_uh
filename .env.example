# LIVE / Studio environment. Copy to .env and fill GCP values.

# `local` or `cloud`.
APP_ENV=local
# the rebuilt onboarding's bucket: product and regulation PDFs, reads, approvals, releases
ONBOARDING_GCS_BUCKET=
# the product read (one call per PDF)
ONBOARDING_MODEL=gemini-3.8-flash
PREFILTER=full
# D-296: relation arm (evidence ids + relation)
# D-302 vote arm: the extra runs' temperature (empty = model default), self-reported confidence (off|self)
JUDGE_TEMPERATURE=
JUDGE_SEED=7
VERIFY_TIMEOUT_MS=5000
# D-304: meaning rules in code, each switchable against the model's judgment (defaults: today)
VERBAL_CHECK=code
COMMENT_PRODUCT=code
GROUP_JOIN=code
SHOUTOUT=regex
FACT_PROMPT=v5
QUESTION_HOLD_MS=2500
# D-280: fact drop fixes, comma-separated (F1 re-field, F2 quote grounding, F3 D-165, F4 restatement, F5 language)
FACT_FIXES=F1,F5,Q6
DATA_DIR=../data
# Path to prompt files.
PROMPTS_DIR=../prompts
# `memory` or `firestore`.
STORE=memory
# D-354: STORE=firestore mirrors every write to this Firestore database (memory stays the read model).
FIRESTORE_DATABASE=live-studio
# D-428: an ended session leaves memory this long after its summary is written (STORE=firestore keeps it and reads it
# back when it is opened). 0 keeps every session in memory.
SESSION_EVICT_AFTER_SEC=900
# `vertex` or `mock` (mock reads canned outputs, §14.2).
LLM_PROVIDER=vertex
# `google_v2` or `mock` (text injection only).
STT_PROVIDER=google_v2
# Required when any Google provider is used.
GCP_PROJECT=
# Vertex AI location for Gemini.
LLM_LOCATION=global
# Real-time agents (judge, fact, triage). Verify id (§16).
LLM_FAST_MODEL=gemini-3.5-flash-lite
# Thinking level for fast model.
LLM_FAST_THINKING=MINIMAL
# Composer, brief, summary. Verify id (§16).
LLM_QUALITY_MODEL=gemini-3.8-flash
# Thinking level for quality model.
LLM_QUALITY_THINKING=MEDIUM
# Thinking level for AnswerComposer only (overrides LLM_QUALITY_THINKING for it; Brief and Summary keep the quality level).
COMPOSER_THINKING=LOW
PD_THINKING=LOW
# The context judge's thinking level on the fast model (D-128).
CONTEXT_THINKING=MINIMAL
# D-450/D-455: the prompter judge (the only judge that ticks points): model and thinking level; no deadline, nothing waits on it.
PROMPTER_MODEL=gemini-3.8-flash
PROMPTER_THINKING=LOW
# D-246: the fact checker's model; empty = LLM_FAST_MODEL
SINGLE_MODEL=gemini-3.5-flash-lite
SINGLE_THINKING=LOW
SINGLE_FACTS_THINKING=LOW
COMPLIANCE_MODEL=
FACTS_MODEL=
TRIAGE_THINKING=LOW
# Retries on 5xx. Never retry on timeout.
LLM_RETRY_ON_5XX=1
LLM_RETRY_ON_429_MS=500
# Gemini context caching for static prompt parts (§8.12.4).
LLM_CONTEXT_CACHE=true
# Fallback cache lifetime; a session's planned run time overrides it.
LLM_CONTEXT_CACHE_TTL_SEC=3600
# `split3` (compliance judge + context judge + fact checker in parallel, D-099), `split`
# (one utterance judge + fact checker in parallel; rollback) or `single` (one call).
JUDGE_MODE=split3
# Deadline of each utterance judge call.
JUDGE_TIMEOUT_MS=2500
JUDGE_HEDGE_MS=1500
# D-287: agents that get the second request, e.g. compliance (empty = all on the alert path)
HEDGED_AGENTS=compliance,fact,context
# D-292: per-agent hedge delay, e.g. fact=3000,context=2000 (others: JUDGE_HEDGE_MS)
HEDGE_DELAYS=fact=3000,context=2000
DESIGN_ARM=A
LLM_USAGE_REPORT=
# A final whose previous final arrived within this window and did not end with . ? or ! is judged
# together with it (reflex, judge, fact checker; D-088). 0 turns merging off.
UTTERANCE_MERGE_WINDOW_MS=3500
# Fact checker LLM deadline (after retrieval).
FACT_TIMEOUT_MS=5000
# D-144: the fact checker may still answer until this; its note is shown late (the health dot counts it)
FACT_LATE_MS=5000
# Live retrieval deadline for fact checking; on timeout use prefetched passages only.
FACT_SEARCH_TIMEOUT_MS=600
# Comment triage deadline.
TRIAGE_MODEL=gemini-3.8-flash
TRIAGE_TIMEOUT_MS=10000
TRIAGE_FALLBACK_THINKING=MEDIUM
TRIAGE_FALLBACK_TIMEOUT_MS=8000
TRIAGE_RETRIES=2
TRIAGE_RETRY_AFTER_MS=5000
# Model Armor on viewer comments (D-125): prefilter, then Armor, then triage. A blocked comment is
# never sent to an LLM; on an error or timeout the comment stays unscreened (shown, never answered).
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE=live-studio-comments
MODEL_ARMOR_TIMEOUT_MS=500
# Triage calls in flight. A comment that finds a free slot is triaged alone; comments arriving while
# all slots are busy wait and go together in one call of up to TRIAGE_MAX_BATCH comments.
TRIAGE_CONCURRENCY=8
TRIAGE_MAX_BATCH=10
# Deadline of one batched triage call.
TRIAGE_BATCH_TIMEOUT_MS=5000
# Answer composer deadline.
COMPOSER_TIMEOUT_MS=12000
# LLM draft verifier after the code checks (D-126); a fail, timeout or error leaves the draft for the operator
# Summary agent deadline.
SUMMARY_TIMEOUT_MS=30000
# Market (data/markets/<code>.json: regulator, rules, currency) and broadcast language
# (data/lang/<code>.json: reflex phrases, cues, wording), D-129. The language must be offered by the market.
MARKET=SG
BROADCAST_LANGUAGE=en
# Speech-to-Text V2 location. Verify for chirp_3 (§16).
STT_LOCATION=us
# 
STT_MODEL=chirp_3
STT_ENDPOINTING=STANDARD
# Empty: the market pack's chirp_3 code for BROADCAST_LANGUAGE (SG English: en-US; chirp_3 rejects en-SG).
STT_LANGUAGE=
# Send confirmed glossary as phrase hints if the model supports adaptation (§10.3).
STT_PHRASE_HINTS_ENABLED=true
# 
VERTEX_SEARCH_LOCATION=global
# viewer answers' evidence: local, or the Vertex AI Search app below
ANSWER_RETRIEVER=vertex_search
VERTEX_SEARCH_ENGINE_ID=ai-budiler-cup-uh-search_1791461058419
VERTEX_ANSWER_TIMEOUT_MS=8000
# an approved product's PDF is copied here (the Vertex AI Search data store's source)
VERTEX_SEARCH_GCS_BUCKET=
# Operator escalation if a HIGH alert is not corrected.
COMPLIANCE_ESCALATE_SEC=5
# Green "Corrected" confirmation on host.
CORRECTED_TOAST_MS=1500
# Host hides an uncorrected fact note after this; operator keeps it.
# Pending window before a host answer is posted.
PUBLISH_CANCEL_WINDOW_MS=2000
# D-349: seconds after a switch or an undo in which the fact checker and the compliance judge get both products.
SWITCH_DUAL_SCOPE_SEC=10
# D-351: immediate switch arm: a failed context call is made once more; both calls share this deadline.
CONTEXT_RETRY_TOTAL_MS=4000
# Operator may undo a switch within this time.
UNDO_SWITCH_WINDOW_SEC=60
# Comment attribution uses the product on air at `received_at - STREAM_GRACE_SEC`.
STREAM_GRACE_SEC=2
# Host question slots.
HOST_TOP_N=6
# A question stays on the host screen at least this long unless answered, recalled or switched away.
HOST_MIN_DWELL_SEC=20
# Auto-answered groups with at least this many unique askers also become host candidates.
HOST_REPEAT_THRESHOLD=3
# New askers of an already answered group within this window are added to the same reply message.
REPLY_COALESCE_SEC=10
# Operator highlights unanswered questions older than this.
STALE_COMMENT_SEC=300
# Open group with no new member and not on host closes after this.
DEFAULT_SHOW_MODE=team
GROUP_TTL_SEC=600
GROUP_TTL_WAITING_SEC=3600
# Open questions passed to the judge.
JUDGE_MAX_OPEN_QUESTIONS=5
# Passages for the composer.
COMPOSER_TOP_K=6
# Per session. Excess comments are rejected with 429.
COMMENT_RATE_LIMIT_PER_MIN=120
# 
COMMENT_RATE_LIMIT_PER_AUTHOR_PER_MIN=10
# Longer comments are truncated for analysis, stored in full.
MAX_COMMENT_CHARS=300
# 
AUTO_ANSWER_ENABLED=true
COMPOSE_RETRIES=1
COMPOSE_RETRY_AFTER_MS=5000
SENSITIVE_APPROVAL=both
REPLY_TRANSLATION_TIMEOUT_MS=4000
# Shows the viewer input box enabled when true. Recorded demo uses false.
VIEWER_INPUT_ENABLED=false
# Demo Console and transcript injection endpoints. MUST be false in `cloud` unless explicitly set.
DEMO_TOOLS_ENABLED=true
# 
LOG_LEVEL=INFO
